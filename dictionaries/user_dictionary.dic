# Пользовательский словарь нормализации Silero TTS (формат ru-normalizr)
# Формат: ключ=замена. Регистр не важен. Строка '#' — комментарий.
# Поддерживаются wildcard-правила:  5g*=пяти джи   (5g + любые символы до пробела)
# и якорь начала строки:  $hello=привет

# --- Бренды и термины, которые IPA-латинизация читает неудачно ---
github=гитхаб
whatsapp=вотсап
instagram=инстаграм
tiktok=тикток
discord=дискорд
spotify=спотифай
telegram=телеграм

# --- Программные термины / расширения файлов ---
venv=ви энв
git=гит
txt=ти экс тэ
py=пай

# --- Число+буква: встроенная латинизация даёт «пять-джи» — если нужно другое, раскомментируйте:
# 5g=пяти джи
# 2fa=двухфакторной
